# Copy to .env and fill in. Never commit .env.
ODDS_API_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/nfl_edge
REDIS_URL=redis://localhost:6379/0

# Optional providers. The model runs without these but marks affected
# projections lower-confidence rather than treating missing features as zero.
WEATHER_API_KEY=
PFF_API_KEY=

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
ODDS_REGIONS=us,us2
DEFAULT_SIMULATIONS=10000
DEVIG_METHOD=multiplicative
KELLY_FRACTION=0.25
KELLY_CAP=0.02
